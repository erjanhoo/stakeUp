# Copy to .env at repository root. Local mode is for loopback development only.
AUTH_MODE=local
PORT=3001
APP_ORIGIN=http://localhost:5173
LOCAL_DATA_FILE=.local/stakeup.json

# Production / connected development: change AUTH_MODE to supabase and set all four.
# Never put a secret/service-role key in a VITE_ variable.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
